# Required for Vercel production metadata; optional for local rendering.
NEXT_PUBLIC_SITE_URL=https://jhonreyconsolacion.vercel.app

# Supabase: server-side contact storage and atomic AI rate limiting.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A private random salt for hashing rate-limit IPs. Never use a NEXT_PUBLIC_ key.
IP_HASH_SALT=

# Contact email (set a verified sender in Resend).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Gemini: portfolio chat and prompt enhancement.
GOOGLE_GENERATIVE_AI_API_KEY=

# Cloudflare Workers AI: image generation.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=
IMAGE_DAILY_GLOBAL_LIMIT=50
ENHANCE_DAILY_IP_LIMIT=10
ENHANCE_DAILY_GLOBAL_LIMIT=100

# Optional error monitoring; leave empty to disable.
SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
